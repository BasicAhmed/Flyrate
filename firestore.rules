rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rates/{corridor} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rateHistory/{corridor} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sales/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /carBookings/{id} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.status == "awaiting_payment"
                    || request.auth != null;
    }
    // Dates-only mirror of carBookings, with no renter info, so the public
    // booking calendar can show which dates are taken.
    match /bookedRanges/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['start', 'end']);
      allow update, delete: if request.auth != null;
    }
  }
}
