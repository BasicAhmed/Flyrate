rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rates/{corridor} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sales/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /carBookings/{id} {
      // Dashboard (auth only) can read the full list and update statuses.
      allow read, update, delete: if request.auth != null;
      // Anyone can create a booking, but only in the "awaiting_payment"
      // state — this is what lets the public self-booking page work
      // without an account, while preventing spoofed confirmed/active
      // bookings from being created directly.
      allow create: if request.resource.data.status == "awaiting_payment"
                    || request.auth != null;
    }
  }
}
